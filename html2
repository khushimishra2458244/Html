<!DOCTYPE html>
<html>
<head>
    <title>Sweet Cake Store</title>
</head>

<body>

    <header>
        <h1>Sweet Cake Store </h1>
        <p>Delicious Cakes Made With Love!</p>
        <hr>
    </header>

    <nav>
        <a href="#home">Home</a> 
        <a href="#cakes">Our Cakes</a> 
        <a href="#about">About Us</a> 
        <a href="#contact">Contact</a>
    </nav>

    <hr>

    <main>

        <section id="home">
            <h2>Welcome to Sweet Cake Store!</h2>

            <p>
                We make fresh, delicious, and beautiful cakes for every
                special occasion. From birthdays to weddings, we have the
                perfect cake for you!
            </p>

            <img src="

                 alt="Delicious Cake">

            <h3>Why Choose Us?</h3>
            <ul>
                <li>Fresh Ingredients</li>
                <li>Custom Cake Designs</li>
                <li>Affordable Prices</li>
                <li>Fast Delivery</li>
            </ul>
        </section>

        <hr>

        <section id="cakes">
            <h2>Our Popular Cakes</h2>

            <table border="1" cellpadding="10">
                <tr>
                    <th>Cake Name</th>
                    <th>Flavor</th>
                    <th>Price</th>
                </tr>

                <tr>
                    <td>Chocolate Cake</td>
                    <td>Chocolate</td>
                    <td>500</td>
                </tr>

                <tr>
                    <td>Vanilla Cake</td>
                    <td>Vanilla</td>
                    <td>450</td>
                </tr>

                <tr>
                    <td>Strawberry Cake</td>
                    <td>Strawberry</td>
                    <td>550</td>
                </tr>

                <tr>
                    <td>Black Forest Cake</td>
                    <td>Chocolate & Cherry</td>
                    <td>600</td>
                </tr>
            </table>

            <h3>Special Order</h3>
            <p>We also make custom cakes for:</p>

            <ol>
                <li>Birthdays </li>
                <li>Weddings </li>
                <li>Anniversaries </li>
                <li>Parties </li>
            </ol>
        </section>

        <hr>

        <section id="about">
            <h2>About Us</h2>

            <p>
                Sweet Cake Store is a small bakery dedicated to making
                delicious and beautiful cakes. Our talented bakers use
                fresh ingredients to create cakes that make every
                celebration special.
            </p>
        </section>

        <hr>

        <section id="contact">
            <h2>Contact Us</h2>

            <p><strong>Phone:</strong> +91 95######</p>
            <p><strong>Email:</strong> sweetcakestore@email.com</p>
            <p><strong>Address:</strong> Hisar, Haryana, India</p>

            <h3>Place Your Order</h3>

            <form>
                <label>Your Name:</label><br>
                <input type="text" name="name"><br><br>

                <label>Email:</label><br>
                <input type="email" name="email"><br><br>

                <label>Select Cake:</label><
                <select name="cake">
                    <option>Chocolate Cake</option>
                    <option>Vanilla Cake</option>
                    <option>Strawberry Cake</option>
                    <option>Black Forest Cake</option>
                </select><br><br>

                <label>Quantity:</label><br>
                <input type="number" name="quantity"><br><br>

                <label>Special Message:</label><br>
                <textarea name="message" rows="5" cols="30"></textarea>
                <br><br>

                <input type="submit" value="Place Order">
                <input type="reset" value="Clear">
            </form>
        </section>

    </main>

    <hr>

    <footer>
        <p> 2026 Sweet Cake Store | Made with  love and passion </p>
    </footer>

</body>
</html>